[Unit]
Description=D-Money payment platform (gunicorn) for pay.sahansolution.com
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pay.sahansolution.com
EnvironmentFile=/var/www/pay.sahansolution.com/.env
Environment=PYTHONUNBUFFERED=1
# gunicorn 27's control server writes $HOME/.gunicorn; www-data's home (/var/www)
# isn't writable, so point HOME at the private tmp dir to silence the error.
Environment=HOME=/tmp
RuntimeDirectory=gunicorn-dmoney
ExecStart=/var/www/pay.sahansolution.com/.venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn-dmoney/pay.sock \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    run:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
