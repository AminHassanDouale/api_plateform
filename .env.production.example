# ---------------------------------------------------------------------------
# Production environment for the D-Money platform on pay.sahansolution.com
# Copy to `.env` on the server and load it (e.g. `set -a; . ./.env; set +a`)
# or export these in your systemd unit / Docker env before launching gunicorn.
# ---------------------------------------------------------------------------

# Public host (used for the Developers tab base URL + partner snippets)
PLATFORM_BASE_URL=https://pay.sahansolution.com

# The URL D-Money POSTs results to. MUST be public HTTPS and reachable.
DMONEY_NOTIFY_URL=https://pay.sahansolution.com/user/v1/payments/d-money/notify

# Where the shopper lands after paying (override per-payment with `return_url`)
DMONEY_DEFAULT_REDIRECT_URL=https://pay.sahansolution.com/payment/return

# --- Security: set these before going live (see docs/partner-integration.md) ---
SECRET_KEY=change-me-to-a-long-random-secret
DMONEY_STRICT_SIGNATURE=1          # reject unsigned/forged webhooks
DMONEY_VERIFY_TLS=1                # verify the gateway's TLS cert
DMONEY_SIMULATE=0                  # make REAL token/preOrder/queryOrder calls

# --- Real merchant credentials (replace the TEST defaults) ---
DMONEY_PRIVATE_KEY_B64=
DMONEY_APPID=
DMONEY_MERCH_CODE=
DMONEY_APP_KEY=
DMONEY_APP_SECRET=
DMONEY_PUBLIC_KEY_PATH=/path/to/dmoney_public_key.pem

# --- Production database (Postgres/MySQL instead of the bundled SQLite) ---
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/dmoney
